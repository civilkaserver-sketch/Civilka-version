{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "silent_step",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/silent_step"
        }
      },
      {
        "when": "mirror_armor",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/mirror_armor"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/feather"
    }
  }
}
